DEBUG=True
DEBUG_FRAGMENT=True
DEBUG_PLATEGA=True
DEBUG_PAYPEAR=True
USE_SSL=False
SECRET_KEY=ваш_очень_секретный_ключ
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_DOMAIN=https://example.ru/
# webhook_secret нужно сгенерировать самому; длина 32-64 символа; можно использовать secrets.token_urlsafe(...)
FRAGMENT_WEBHOOK_SECRET=секретный_токен_для_авторизации_вебхука

CELERY_BROKER_URL=redis://redis:6379/0

TELEGRAM_BOT_TOKEN=ваш_токен_телеграм_бота
ADMIN_CHAT_ID=id_админской_группы
ADMIN_BROADCAST_TOPIC_ID=id_топика_для_предпросмотра_рассылок
ADMIN_ORDERS_TOPIC_ID=id_топика_для_уведомлений_о_созданных_заказах
NOTIFY_ABOUT_ORDERS=True
CHANNEL_ID=id_канала
CHANNEL_LINK=ссылка_на_канал

SUPPORT_URL=url_поддержки
FEEDBACK_URL=url_где_можно_оставить_отзыв

FRAGMENT_API_URL=https://api.fragment-api.com/v1/
FRAGMENT_CURRENCY=TON
# Как часто перечитывать статусы заказов Fragment (вебхук response_url ненадёжен)
FRAGMENT_POLL_SECONDS=15
# Сколько часов после создания транзакции ещё опрашивать её заказ
FRAGMENT_POLL_MAX_AGE_HOURS=24
# Через сколько минут "зависший" заказ помечать как ПОД СОМНЕНИЕМ
FRAGMENT_POLL_DOUBT_AFTER_MINUTES=30

PLATEGA_API_URL=https://app.platega.io/
PLATEGA_MERCHANT_ID=данные_от_менеджера_или_из_ЛК
PLATEGA_SECRET=данные_от_менеджера_или_из_ЛК

PAYPEAR_API_URL=https://api.paypear.ru/v1/
PAYPEAR_SHOP_ID=id_магазина_из_ЛК
PAYPEAR_SECRET=секрет_из_ЛК
# IP, с которых PayPear шлёт вебхуки (через запятую)
PAYPEAR_WEBHOOK_IPS=158.160.85.101
PAYPEAR_USE_WEBHOOK=True
PAYPEAR_POLL_SECONDS=5